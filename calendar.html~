<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Countdown calendar</title>
<style>
  body {
    background: #FFFFFA;
    color: #333333;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 16px;
    margin: 0;
  }
  h1 { font-size: 18px; font-weight: 500; letter-spacing: .04em; margin: 0 0 4px; }
  .sub { font-size: 13px; opacity: .55; margin-bottom: 20px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
    width: min(560px, 100%);
  }
  .dow {
    text-align: center;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .45;
    padding-bottom: 4px;
  }
  .cell {
    aspect-ratio: 1 / .8;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-variant-numeric: tabular-nums;
    position: relative;
  }
  .cell .mlabel {
    position: absolute;
    top: 1px;
    left: 2px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    opacity: 1;
  }
  .cell.blank { background: none; }
  .cell.first { font-weight: 700; }
  .legend { display: flex; gap: 14px; margin-top: 22px; font-size: 12px; flex-wrap: wrap; justify-content: center; }
  .legend div { display: flex; align-items: center; gap: 6px; }
  .swatch { width: 12px; height: 12px; border-radius: 3px; }
  .controls {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    margin-bottom: 18px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .controls label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .55;
  }
  .controls input {
    font: inherit;
    font-size: 14px;
    text-transform: none;
    letter-spacing: normal;
    color: #333;
    background: #fff;
    border: 1px solid #d8d8d0;
    border-radius: 5px;
    padding: 5px 8px;
  }
</style>
</head>
<body>

<h1 id="title">Calendar</h1>
<div class="sub" id="sub"></div>
<div class="controls">
  <label>Start <input type="date" id="startInput"></label>
  <label>End <input type="date" id="endInput"></label>
</div>
<div class="grid" id="grid"></div>
<div class="legend" id="legend"></div>

<script>
/* ======================= CONFIG — EDIT HERE ======================= */

// Inclusive range shown, in YYYY-MM-DD. These are just the starting values for
// the date pickers on the page — edits there override them (and are remembered).
const START_DATE = "2026-07-13";
const END_DATE   = "2026-11-15";

// Timezone used to decide whether a day is "over".
const TIMEZONE = "America/New_York";  // EST/EDT

// Color per month (1 = January ... 12 = December).
// Add/change hex values freely; months not listed fall back to DEFAULT_COLOR.
const MONTH_COLORS = {
  8:  "#4f8ac9",  // August
  9:  "#5cb28f",  // September
  10: "#d9a441",  // October
  11: "#c96f6f",  // November
};
const DEFAULT_COLOR = "#7a7f8a";

// How much darker a finished (past) day is. 0 = unchanged, 1 = black.
const PAST_DARKEN = 0.5;

// How much lighter Saturdays and Sundays are. 0 = unchanged, 1 = white.
const WEEKEND_LIGHTEN = 0.45;

// Text colors.
const TEXT_ON_FUTURE = "#10131a";
const TEXT_ON_PAST   = "rgba(255,255,255,0.8)";

/* ================== END CONFIG (logic below) ===================== */

const MONTH_NAMES = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];

function parseISO(s) {
  const parts = (s || "").split("-").map(Number);
  if (parts.length !== 3 || parts.some(n => !Number.isFinite(n))) return null;
  const [y, m, d] = parts;
  return { y, m, d };
}
// Days since epoch for a civil date — avoids all Date/timezone weirdness.
function toOrdinal({y, m, d}) {
  const a = Math.floor((14 - m) / 12);
  const yy = y + 4800 - a;
  const mm = m + 12 * a - 3;
  return d + Math.floor((153 * mm + 2) / 5) + 365 * yy
    + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) - 32045;
}
function fromOrdinal(jdn) {
  let a = jdn + 32044;
  const b = Math.floor((4 * a + 3) / 146097);
  const c = a - Math.floor(146097 * b / 4);
  const dd = Math.floor((4 * c + 3) / 1461);
  const e = c - Math.floor(1461 * dd / 4);
  const mm = Math.floor((5 * e + 2) / 153);
  return {
    d: e - Math.floor((153 * mm + 2) / 5) + 1,
    m: mm + 3 - 12 * Math.floor(mm / 10),
    y: 100 * b + dd - 4800 + Math.floor(mm / 10)
  };
}
// 0 = Monday ... 6 = Sunday
function dowMon(jdn) { return ((jdn % 7) + 7) % 7; }

function darken(hex, amount) {
  const n = parseInt(hex.slice(1), 16);
  const r = Math.round(((n >> 16) & 255) * (1 - amount));
  const g = Math.round(((n >> 8) & 255) * (1 - amount));
  const b = Math.round((n & 255) * (1 - amount));
  return `rgb(${r}, ${g}, ${b})`;
}

function lighten(hex, amount) {
  const n = parseInt(hex.slice(1), 16);
  const mix = (c) => Math.round(c + (255 - c) * amount);
  const r = mix((n >> 16) & 255);
  const g = mix((n >> 8) & 255);
  const b = mix(n & 255);
  return "#" + ((1 << 24) | (r << 16) | (g << 8) | b).toString(16).slice(1);
}

// Today's civil date in TIMEZONE.
function todayInTZ() {
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: TIMEZONE, year: "numeric", month: "2-digit", day: "2-digit"
  }).format(new Date());
  return parseISO(parts);
}

const startInput = document.getElementById("startInput");
const endInput   = document.getElementById("endInput");

// Restore any dates the user picked previously, else fall back to the config.
startInput.value = localStorage.getItem("cal.start") || START_DATE;
endInput.value   = localStorage.getItem("cal.end")   || END_DATE;

function render() {
  const start = parseISO(startInput.value);
  const end   = parseISO(endInput.value);
  if (!start || !end) return;

  const startJ = toOrdinal(start);
  const endJ   = toOrdinal(end);
  const todayJ = toOrdinal(todayInTZ());

  if (endJ < startJ) {
    document.getElementById("grid").innerHTML = "";
    document.getElementById("legend").innerHTML = "";
    document.getElementById("title").textContent = "Calendar";
    document.getElementById("sub").textContent = "End date is before start date.";
    return;
  }

  const grid = document.getElementById("grid");
  grid.innerHTML = "";

  for (const name of ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]) {
    const el = document.createElement("div");
    el.className = "dow";
    el.textContent = name;
    grid.appendChild(el);
  }

  // Pad so the first week lines up under the right weekday.
  for (let i = 0; i < dowMon(startJ); i++) {
    const el = document.createElement("div");
    el.className = "cell blank";
    grid.appendChild(el);
  }

  const monthsUsed = [];
  for (let j = startJ; j <= endJ; j++) {
    const { y, m, d } = fromOrdinal(j);
    const base = MONTH_COLORS[m] || DEFAULT_COLOR;
    const isPast = j < todayJ;   // a day is "over" once TIMEZONE has moved past it
    const isWeekend = dowMon(j) >= 5;
    const fill = isWeekend ? lighten(base, WEEKEND_LIGHTEN) : base;

    if (!monthsUsed.some(x => x.m === m && x.y === y)) monthsUsed.push({ m, y, base });

    const el = document.createElement("div");
    el.className = "cell" + (d === 1 || j === startJ ? " first" : "");
    el.style.background = isPast ? darken(fill, PAST_DARKEN) : fill;
    el.style.color = isPast ? TEXT_ON_PAST : TEXT_ON_FUTURE;
    el.textContent = d;
    // Label the first day of each month (and the very first cell) with e.g. "AUG".
    if (d === 1 || j === startJ) {
      const tag = document.createElement("span");
      tag.className = "mlabel";
      tag.textContent = MONTH_NAMES[m - 1].slice(0, 3);
      el.appendChild(tag);
    }
    el.title = `${MONTH_NAMES[m - 1]} ${d}, ${y}`;
    grid.appendChild(el);
  }

  const remaining = Math.max(0, endJ - todayJ + 1);
  document.getElementById("title").textContent =
    `${MONTH_NAMES[start.m - 1]} ${start.d} → ${MONTH_NAMES[end.m - 1]} ${end.d}`;
  document.getElementById("sub").textContent =
    `${endJ - startJ + 1} days total · ${remaining} remaining`;

  const legend = document.getElementById("legend");
  legend.innerHTML = "";
  for (const { m, base } of monthsUsed) {
    const wrap = document.createElement("div");
    const sw = document.createElement("span");
    sw.className = "swatch";
    sw.style.background = base;
    wrap.appendChild(sw);
    wrap.appendChild(document.createTextNode(MONTH_NAMES[m - 1]));
    legend.appendChild(wrap);
  }
}

startInput.addEventListener("input", () => {
  localStorage.setItem("cal.start", startInput.value);
  render();
});
endInput.addEventListener("input", () => {
  localStorage.setItem("cal.end", endInput.value);
  render();
});

render();
// Re-check around midnight so the page updates itself if left open.
setInterval(render, 60 * 1000);
</script>
</body>
</html>
